# Copy this file to .env and fill in real values.
# NEVER commit .env, and never paste real secret keys into a chat with anyone — including Claude.

# From Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# From Razorpay Dashboard > Settings > Webhooks (set when you create the webhook, see README)
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Pick your own long random string — this protects the /api/admin/* routes
ADMIN_TOKEN=change-this-to-a-long-random-string

PORT=4000
